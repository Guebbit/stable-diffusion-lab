# ─── Ports (host:container) ──────────────────────
BACKEND_PORT = 8000
FRONTEND_PORT = 5173


# ─── Database ──────────────────────────────────────────────
DATABASE_PORT = 5435
DATABASE_URL = postgresql+asyncpg://ailab:ailab_local@db:5432/ailab
POSTGRES_DB = ailab
POSTGRES_USER = ailab
POSTGRES_PASSWORD = ailab_local


# ─── Storage ──────────────────────────────────────────────
STORAGE_ROOT = /app/storage


# ─── Inference ─────────────────────────────────────────────
INFERENCE_DEVICE = auto
INFERENCE_BACKEND = direct_python
MAX_VRAM_MB = 0
# ALLOW_CPU_FALLBACK = true

# ─── External API Tokens ───────────────────────────────────
HUGGINGFACE_TOKEN = huggingface-read-token
CIVITAI_TOKEN = civitai-token