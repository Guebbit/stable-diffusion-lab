# ─── Ports (host:container) ──────────────────────
BACKEND_PORT = 8000
FRONTEND_PORT = 5173


# ─── Database ──────────────────────────────────────────────
DATABASE_PORT = 5435
DATABASE_URL = postgresql+asyncpg://ailab:ailab_local@db:5432/ailab
POSTGRES_DB = ailab
POSTGRES_USER = ailab
POSTGRES_PASSWORD = ailab_local


# ─── Storage ──────────────────────────────────────────────
STORAGE_PATH = /home/{your_linux_username}/.diffusion_models
STORAGE_ROOT = /app/storage


# ─── Inference ─────────────────────────────────────────────
INFERENCE_DEVICE = auto
INFERENCE_BACKEND = direct_python
MAX_VRAM_MB = 0
# ALLOW_CPU_FALLBACK = true
PYTORCH_CUDA_ALLOC_CONF = expandable_segments:True
# Job timeout in seconds — kills jobs that run too long (0 = disabled)
JOB_TIMEOUT_SECONDS = 0

# Pipeline offload strategy — controls where model weights live during inference:
#   none           — stream all weights directly from disk to VRAM at load time (fastest).
#                    Minimal CPU RAM usage. Job fails cleanly with an OOM error if VRAM
#                    is insufficient — use QUANTIZE_MODE to shrink the model instead.
#   model_cpu      — keep the full model in CPU RAM; move each sub-model (text encoder,
#                    UNet/transformer, VAE) to GPU only for its forward pass. Peak VRAM ≈
#                    largest single sub-model. Fills ~22 GB RAM for FLUX. (default)
#   sequential_cpu — move each individual layer to GPU for its forward pass (~1-2 GB peak
#                    VRAM). Slowest option but runs FLUX on very small GPUs.
#
# RTX 4090 / large VRAM recommendation: PIPELINE_OFFLOAD = none
# Low RAM recommendation: PIPELINE_OFFLOAD = none + QUANTIZE_MODE = full
PIPELINE_OFFLOAD = none

# Quantization — shrink model weights to 4-bit NF4 to reduce VRAM usage.
# Requires: pip install bitsandbytes
# Incompatible with model_cpu / sequential_cpu offload (bitsandbytes tensors live
# on CUDA and cannot be moved to CPU). When both are set, offload is auto-set to none.
#
#   none         — no quantization (default)
#   transformer  — quantize main model only (FLUX transformer: 12 GB → 3 GB)
#   text_encoder — quantize T5 text encoders only (FLUX T5-XXL: 9 GB → 2.5 GB)
#                  Has no effect on SD1.x / SDXL which use small CLIP encoders.
#   full         — both above (FLUX: ~22 GB → ~5.5 GB, fits on 6-8 GB VRAM cards)
QUANTIZE_MODE = none

# ─── External API Tokens ───────────────────────────────────
HUGGINGFACE_TOKEN = huggingface-read-token
CIVITAI_TOKEN = civitai-token