# ─── External API Tokens ───────────────────────────────────
HF_TOKEN=huggingface-read-token
CIVITAI_TOKEN=civitai-token

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=******localhost:5432/ailab

# ─── Storage ──────────────────────────────────────────────
STORAGE_ROOT=/app/storage

# ─── Inference ─────────────────────────────────────────────
INFERENCE_DEVICE=auto
INFERENCE_BACKEND=direct_python
MAX_VRAM_MB=0

# ─── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false